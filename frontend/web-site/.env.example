# Copy thành .env.local cho chạy local (không commit .env.local)
# Vite chỉ expose biến có prefix VITE_

# REST API — mặc định là production Render (xem apiConfig.js)
# Ghi đè khi phát triển local:
# VITE_API_URL=http://127.0.0.1:8000/api

# Production (Render) — đây là giá trị mặc định, không cần set nếu dùng Render
# VITE_API_URL=https://smart-green-market-api.onrender.com/api

# WebSocket thông báo — tự động derive từ VITE_API_URL, chỉ cần set nếu WS dùng domain khác
# VITE_WS_NOTIFICATIONS_URL=wss://smart-green-market-api.onrender.com/ws/notifications/
