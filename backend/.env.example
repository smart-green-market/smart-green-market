# Copy thành .env cho chạy local (không commit .env)
SECRET_KEY=your-local-secret-key
DEBUG=True

DB_NAME=smart_green_market
DB_USER=postgres
DB_PASSWORD=Nguyen+man1
DB_HOST=localhost
DB_PORT=5432

# Render tự inject DATABASE_URL — không cần set khi deploy
# WebSocket (Channels): local cần Redis; Render Blueprint inject REDIS_URL từ Key Value
# REDIS_URL=redis://127.0.0.1:6379/0

# Cloudinary — bắt buộc trên Render để lưu ảnh/file lâu dài (free tier)
# Lấy tại https://cloudinary.com → Dashboard → API Keys → copy "API environment variable"
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# CORS: mặc định cho phép mọi origin (localhost + host UI)
# CORS_ALLOW_ALL_ORIGINS=True
# Muốn giới hạn: CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://my-app.vercel.app,http://localhost:5173

# URL public backend — Swagger Try it out + schema (Render nên set)
# API_PUBLIC_BASE_URL=https://smart-green-market-api.onrender.com

# Email thông báo (tùy chọn — mặc định tắt)
# NOTIFICATION_EMAIL_ENABLED=True
# NOTIFICATION_EMAIL_ASYNC=True
# DEFAULT_FROM_EMAIL=noreply@smartgreenmarket.com
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
